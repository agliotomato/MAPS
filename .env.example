# Copy to .env locally. Never commit real values.
OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DART_API_KEY=

# Economy data: configure an existing service and local vector store explicitly.
ECOS_API_KEY=
FRED_API_KEY=
CUSTOMS_API_KEY=
FIRECRAWL_API_KEY=
TIMESCALE_DSN=
TIMESCALE_SCHEMA=public
CHROMA_PERSIST_DIR=./economy_agent/data/chroma_db

# Semiconductor data: existing PostgreSQL and optional Qdrant.
POSTGRES_DSN=
TIMESCALE_SERVICE_URL=
# Optional external credential file; no machine-specific fallback path.
TIMESCALE_CREDENTIALS_PATH=
OPEN_DART_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# 1 uses PostgreSQL lexical retrieval without Qdrant/BGE.
RAG_QDRANT_DISABLED=1
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_CALL_BUDGET=6

# Existing optional graph connection; graph-based reasoning is not implemented.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
TZ=Asia/Seoul
